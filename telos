#!/bin/bash
# Telos Runtime Orchestrator
# Thin wrapper — delegates to the Python TUI for rich output

set -e

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# Resolve Python path for sudo environments
USER_PACKAGES="/home/${SUDO_USER:-$USER}/.local/lib/python3.14/site-packages"
export PYTHONPATH="$USER_PACKAGES:$PYTHONPATH"

exec python3 "$DIR/telos_cli.py" "$@"
