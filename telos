#!/bin/bash
# Telos Runtime Orchestrator

set -e

# Configuration
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
LOG_DIR="$DIR/logs"
mkdir -p "$LOG_DIR"

DAEMON_LOG="$LOG_DIR/telos_daemon.log"
CORTEX_LOG="$LOG_DIR/telos_cortex.log"
DAEMON_PID_FILE="/tmp/telos_daemon.pid"
CORTEX_PID_FILE="/tmp/telos_cortex.pid"
BPF_PIN_PATH="/sys/fs/bpf/telos"

# Modern Colors (Lipgloss Aesthetic)
PINK='\033[38;5;205m'
PURPLE='\033[38;5;135m'
CYAN='\033[38;5;51m'
GRAY='\033[38;5;240m'
WHITE='\033[38;5;255m'
GREEN='\033[38;5;120m'
RED='\033[38;5;196m'
YELLOW='\033[38;5;226m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

function print_header {
  echo -e ""
  echo -e "  ${PURPLE}╭────────────────────────────────────────────────────────╮${NC}"
  echo -e "  ${PURPLE}│${NC}  ${PINK}${BOLD}T E L O S${NC}                                             ${PURPLE}│${NC}"
  echo -e "  ${PURPLE}│${NC}  ${GRAY}Runtime Security Engine${NC}                               ${PURPLE}│${NC}"
  echo -e "  ${PURPLE}╰────────────────────────────────────────────────────────╯${NC}"
  echo -e ""
}

function check_root {
  if [ "$EUID" -ne 0 ]; then
    echo -e "  ${RED}✕${NC}  ${WHITE}Please run as root (use sudo).${NC}"
    exit 1
  fi
}

function step_ok {
  echo -e "  ${GREEN}▶${NC}  $1"
}

function step_warn {
  echo -e "  ${YELLOW}▲${NC}  $1"
}

function step_fail {
  echo -e "  ${RED}✕${NC}  $1"
  exit 1
}

function step_work {
  echo -n -e "  ${GRAY}◼${NC}  $1... "
}

function step_done {
  echo -e "${GREEN}OK${NC} $1"
}

function start_telos {
  # Forward args
  shift
  ARGS="$@"

  echo -e "  ${WHITE}${BOLD}Starting Telos Runtime${NC}\n"
  
  cd "$DIR"

  # 1. Build
  step_work "Building eBPF Core"
  make bpf > /dev/null 2>&1 || { echo -e "${RED}Failed${NC}"; exit 1; }
  step_done

  step_work "Building Go Loader"
  make loader > /dev/null 2>&1 || { echo -e "${RED}Failed${NC}"; exit 1; }
  step_done

  # 2. Start Daemon
  if [ -f "$DAEMON_PID_FILE" ] && kill -0 $(cat "$DAEMON_PID_FILE") 2>/dev/null; then
    step_warn "Telos Daemon is already running (PID: $(cat $DAEMON_PID_FILE))"
  else
    step_work "Starting Telos Daemon"
    rm -f "$DAEMON_LOG"
    nohup ./bin/telos_daemon $ARGS < /dev/null > "$DAEMON_LOG" 2>&1 &
    DAEMON_PID=$!
    echo $DAEMON_PID > "$DAEMON_PID_FILE"
    step_done "${GRAY}(PID: $DAEMON_PID)${NC}"
  fi

  sleep 1

  # 3. Start Cortex
  if [ -f "$CORTEX_PID_FILE" ] && kill -0 $(cat "$CORTEX_PID_FILE") 2>/dev/null; then
    step_warn "Telos Cortex is already running (PID: $(cat $CORTEX_PID_FILE))"
  else
    step_work "Starting Telos Cortex"
    rm -f "$CORTEX_LOG"
    USER_PACKAGES="/home/${SUDO_USER:-$USER}/.local/lib/python3.14/site-packages"
    CORTEX_TOKEN="${TELOS_CORTEX_AUTH_TOKEN:-telos-dev-token}"
    nohup env PYTHONPATH="$USER_PACKAGES:$PYTHONPATH" TELOS_CORTEX_LOG="$CORTEX_LOG" TELOS_CORTEX_AUTH_TOKEN="$CORTEX_TOKEN" python3 cortex/main.py $ARGS < /dev/null > "$CORTEX_LOG" 2>&1 &
    CORTEX_PID=$!
    echo $CORTEX_PID > "$CORTEX_PID_FILE"
    step_done "${GRAY}(PID: $CORTEX_PID)${NC}"
  fi

  echo -e "\n  ${GREEN}${BOLD}Telos is now running.${NC}"
  echo -e "  ${GRAY}┃${NC}  ${WHITE}Daemon Log${NC}    ${CYAN}$DAEMON_LOG${NC}"
  echo -e "  ${GRAY}┃${NC}  ${WHITE}Cortex Log${NC}    ${CYAN}$CORTEX_LOG${NC}"
  echo -e ""
}

function stop_telos {
  echo -e "  ${WHITE}${BOLD}Stopping Telos Runtime${NC}\n"

  if [ -f "$CORTEX_PID_FILE" ]; then
    PID=$(cat "$CORTEX_PID_FILE")
    if kill -0 "$PID" 2>/dev/null; then
      step_work "Stopping Cortex (PID $PID)"
      kill -TERM "$PID"
      sleep 2
      if kill -0 "$PID" 2>/dev/null; then
        kill -9 "$PID"
      fi
      step_done
    else
        step_warn "Cortex is not running (stale PID file)"
    fi
    rm -f "$CORTEX_PID_FILE"
  else
      step_warn "Cortex PID file not found"
  fi

  if [ -f "$DAEMON_PID_FILE" ]; then
    PID=$(cat "$DAEMON_PID_FILE")
    if kill -0 "$PID" 2>/dev/null; then
      step_work "Stopping Daemon (PID $PID)"
      kill -TERM "$PID"
      sleep 2
      if kill -0 "$PID" 2>/dev/null; then
        kill -9 "$PID"
      fi
      step_done
    else
        step_warn "Daemon is not running (stale PID file)"
    fi
    rm -f "$DAEMON_PID_FILE"
  else
      step_warn "Daemon PID file not found"
  fi

  step_work "Cleaning up BPF maps"
  if mount | grep -q "$BPF_PIN_PATH"; then
      umount "$BPF_PIN_PATH"
  fi
  rm -rf "$BPF_PIN_PATH"
  step_done
  
  echo -e "\n  ${GREEN}${BOLD}Telos stopped.${NC}\n"
}

function status_telos {
  echo -e "  ${WHITE}${BOLD}Telos Runtime Status${NC}\n"
  
  if [ -f "$DAEMON_PID_FILE" ] && kill -0 $(cat "$DAEMON_PID_FILE") 2>/dev/null; then
    echo -e "  ${GRAY}┃${NC}  ${WHITE}Telos Daemon${NC}    ${GREEN}RUNNING${NC}  ${GRAY}(PID: $(cat $DAEMON_PID_FILE))${NC}"
  else
    echo -e "  ${GRAY}┃${NC}  ${WHITE}Telos Daemon${NC}    ${RED}STOPPED${NC}"
  fi

  if [ -f "$CORTEX_PID_FILE" ] && kill -0 $(cat "$CORTEX_PID_FILE") 2>/dev/null; then
    echo -e "  ${GRAY}┃${NC}  ${WHITE}Telos Cortex${NC}    ${GREEN}RUNNING${NC}  ${GRAY}(PID: $(cat $CORTEX_PID_FILE))${NC}"
  else
    echo -e "  ${GRAY}┃${NC}  ${WHITE}Telos Cortex${NC}    ${RED}STOPPED${NC}"
  fi

  if [ -d "$BPF_PIN_PATH" ] && [ "$(ls -A $BPF_PIN_PATH 2>/dev/null)" ]; then
    echo -e "  ${GRAY}┃${NC}  ${WHITE}BPF Maps${NC}        ${GREEN}PINNED${NC}   ${GRAY}($BPF_PIN_PATH/)${NC}"
  else
    echo -e "  ${GRAY}┃${NC}  ${WHITE}BPF Maps${NC}        ${RED}NOT FOUND${NC}"
  fi
  echo -e ""
}

cd "$DIR"

case "$1" in
  start)
    print_header
    check_root
    start_telos "$@"
    ;;
  stop)
    print_header
    check_root
    stop_telos
    ;;
  status)
    print_header
    status_telos
    ;;
  dash)
    python3 cortex/telemetry_ui.py || python3 telemetry_ui.py
    ;;
  help)
    print_header
    echo -e "  ${BOLD}USAGE:${NC} sudo ./telos {${GREEN}start${NC}|${RED}stop${NC}|${CYAN}dash${NC}|${YELLOW}status${NC}|help} [args...]\n"
    
    echo -e "  ${BOLD}COMMANDS:${NC}"
    echo -e "    ${GREEN}start${NC}    Builds and starts the Telos Daemon and Cortex AI."
    echo -e "    ${RED}stop${NC}     Stops all background processes and cleans eBPF maps."
    echo -e "    ${CYAN}dash${NC}     Launches the live Telemetry UI dashboard."
    echo -e "    ${YELLOW}status${NC}   Displays the current status of the Daemon and Cortex."
    echo -e "    ${GRAY}help${NC}     Shows this message."
    echo ""
    echo -e "  ${BOLD}ARGUMENTS:${NC}"
    echo -e "    Any additional arguments passed to ${GREEN}start${NC} will be forwarded"
    echo -e "    to both the Daemon and Cortex (e.g. ${PINK}--port 50055${NC})."
    echo ""
    ;;
  *)
    echo "Usage: sudo ./telos {start|stop|dash|status|help}"
    exit 1
    ;;
esac

exit 0
